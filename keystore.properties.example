# Copie para keystore.properties (que NÃO vai para o git) e preencha.
# A keystore e as senhas devem ficar guardadas fora do repositório
# (ex.: gerenciador de senhas). Sem ela não é possível atualizar o app
# já instalado nas TV Boxes.
storeFile=../impulsotv-release.jks
storePassword=
keyAlias=impulsotv
keyPassword=
