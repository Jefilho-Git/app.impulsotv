<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    ════════════════════════════════════════════════════════
    Layout único com dois containers exclusivos:

    [pairingContainer]  — tela de pairing (código alfanumérico)
    [playerContainer]   — player nativo (ExoPlayer + ImageView)

    Apenas um é visível por vez. A troca é feita em MainActivity
    via showPairing() / showPlayer().
    ════════════════════════════════════════════════════════
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ═══════════════════════════════════════════════════════════
         PAIRING CONTAINER
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/pairingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/black"
        android:padding="48dp"
        android:visibility="gone">

        <!-- Logo Oficial Impulso TV -->
        <ImageView
            android:layout_width="320dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_logo_horizontal"
            android:layout_marginBottom="32dp" />

        <!-- Instrução -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_instruction"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Campo de código — centralizado, estilo limpo -->
        <EditText
            android:id="@+id/etCode"
            android:layout_width="320dp"
            android:layout_height="64dp"
            android:hint="@string/pairing_hint"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="6"
            android:imeOptions="actionDone"
            android:background="@drawable/bg_code_input"
            android:layout_marginBottom="16dp"
            android:padding="12dp" />

        <!-- Status / erro -->
        <TextView
            android:id="@+id/tvPairingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E94560"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressPairing"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="#E94560"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         SYNC/LOADING CONTAINER (Novo)
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/syncContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/black"
        android:padding="48dp"
        android:visibility="gone">

        <!-- Logo Oficial Impulso TV -->
        <ImageView
            android:layout_width="320dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_logo_horizontal"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sincronizando Mídias"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressSync"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/bg_code_input"
            android:progressTint="#E94560"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         PLAYER CONTAINER
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/black"
        android:visibility="gone">

        <!-- FrameLayout sobreposto: PlayerView (vídeo) + ImageView (imagem) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/black">

            <!-- Vídeo — ExoPlayer (PlayerView do Media3). Sempre visível, POR BAIXO
                 da imagem: as transições são feitas só com o fade da imagem. -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/black"
                android:keepScreenOn="true"
                app:use_controller="false"
                app:surface_type="texture_view"
                app:shutter_background_color="@android:color/black" />

            <!-- Imagem — Coil carrega aqui -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@android:color/black"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="#33FFFFFF"
            android:textSize="10sp"
            android:padding="8dp"
            android:visibility="gone"
            android:text="" />

    </LinearLayout>

</FrameLayout>
